architecture test0_add_arch of test0_add is
    component reg_add is
        port(
            i_add : in std_logic_vector(15 downto 0);
            i_clk : in std_logic;
            i_rst : in std_logic;
            add_piu : in std_logic;
            add_en : in std_logic;
            
            o_mem_addr : out std_logic_vector(15 downto 0)
        );
     end component; 
     
     signal s_i_add : std_logic_vector(15 downto 0);
     signal s_i_clk : std_logic;
     signal s_i_rst : std_logic;
     signal S_add_piu : std_logic;
     signal s_add_en : std_logic;
     signal s_o_mem_addr : std_logic_vector(15 downto 0);
       
begin
    -- reg_add
    ra : reg_add port map(
        i_clk => s_i_clk,
        i_rst => s_i_rst,
        add_piu => s_add_piu,
        add_en => s_add_en,
        i_add(0) => s_i_add(0),
        i_add(1) => s_i_add(1),
        i_add(2) => s_i_add(2),
        i_add(3) => s_i_add(3),
        i_add(4) => s_i_add(4),
        i_add(5) => s_i_add(5),
        i_add(6) => s_i_add(6),
        i_add(7) => s_i_add(7),
        i_add(8) => s_i_add(8),
        i_add(9) => s_i_add(9),
        i_add(10) => s_i_add(10),
        i_add(11) => s_i_add(11),
        i_add(12) => s_i_add(12),
        i_add(13) => s_i_add(13),
        i_add(14) => s_i_add(14),
        i_add(15) => s_i_add(15),
        o_mem_addr(0) => s_o_mem_addr(0),
        o_mem_addr(1) => s_o_mem_addr(1),
        o_mem_addr(2) => s_o_mem_addr(2),
        o_mem_addr(3) => s_o_mem_addr(3),
        o_mem_addr(4) => s_o_mem_addr(4),
        o_mem_addr(5) => s_o_mem_addr(5),
        o_mem_addr(6) => s_o_mem_addr(6),
        o_mem_addr(7) => s_o_mem_addr(7),
        o_mem_addr(8) => s_o_mem_addr(8),
        o_mem_addr(9) => s_o_mem_addr(9),
        o_mem_addr(10) => s_o_mem_addr(10),
        o_mem_addr(11) => s_o_mem_addr(11),
        o_mem_addr(12) => s_o_mem_addr(12),
        o_mem_addr(13) => s_o_mem_addr(13),
        o_mem_addr(14) => s_o_mem_addr(14),
        o_mem_addr(15) => s_o_mem_addr(15) 
    );
    stim_proc : process
    begin
    
            s_i_rst <= '1';
            s_i_add <= (others => '0');
            s_add_piu <= '1';
            s_add_en <= '1';
            
            wait for 10 ns;
            assert s_o_mem_addr = "0000000000000000" report "Error reset failed";
            
            s_i_rst <= '0';
            s_i_add <= "0000000000000010";
            s_add_piu <= '1';
            s_add_en <= '1';
            --s_i_clk <= '1';
            
            wait until rising_edge(s_i_clk);
            assert s_o_mem_addr = "0000000000000011" report "Error piu failed";
            
        
       report "Test successful";
       wait;
    
    end process;
  
end test0_add_arch;
